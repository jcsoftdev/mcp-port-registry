{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/port-registry\" hook gc" }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.local/bin/port-registry\" hook release" }
        ]
      }
    ]
  }
}
