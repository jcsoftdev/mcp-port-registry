{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "<ABSOLUTE_PATH>/mcp-port-registry/hooks/claude-code/port-registry-hook.sh gc" }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          { "type": "command", "command": "<ABSOLUTE_PATH>/mcp-port-registry/hooks/claude-code/port-registry-hook.sh release" }
        ]
      }
    ]
  }
}
